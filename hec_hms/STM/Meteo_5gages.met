                    </GageWeights>
                    <GageWeights GageName="B605X" Weight="1.00">
                        <DataSource Type="Dss">
                            <DssInfo DssFileName="event_precip.dss" Path="" />
                        </DataSource>
                    </GageWeights>
                    <GageWeights GageName="B691Y" Weight="1.00">
